{
  "name": "tui-qwerty-learner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "description": "Terminal qwerty-learner style word trainer",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node --files src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "sentence:add": "ts-node --files src/tools/add-sentence.ts"
  },
  "dependencies": {
    "neo-blessed": "^0.2.0",
    "playwright-core": "^1.59.1"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^20.16.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
